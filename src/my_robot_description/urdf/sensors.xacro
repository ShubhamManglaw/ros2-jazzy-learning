<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <xacro:macro name="camera">
        <link name="camera_link">
            <visual>
                <geometry>
                    <box size="0.05 0.05 0.05"/>
                </geometry>
                <material name="red"/>
            </visual>
        </link>
        <joint
            name="camera_joint"
            type="fixed">
            <parent link="base_link"/>
            <child link="camera_link"/>
            <origin
                xyz="0.20 0 0.15"
                rpy="0 0 0"/>
        </joint>
    </xacro:macro>
</robot>